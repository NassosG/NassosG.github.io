---
import Base from '../layouts/Base.astro';
import { getThoughtsFor, postPath } from '../lib/thoughts';
import { formatDate, t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const posts = await getThoughtsFor(lang);

const copy = {
  en: {
    title: 'Thoughts',
    description: 'Short essays on architecture, AI, and judgment.',
    lede: 'Short essays on architecture, AI, and judgment.',
    none: 'Nothing published yet.',
  },
  el: {
    title: 'Σκέψεις',
    description: 'Σύντομα κείμενα για την αρχιτεκτονική, την τεχνητή νοημοσύνη και την κρίση.',
    lede: 'Σύντομα κείμενα για την αρχιτεκτονική, την τεχνητή νοημοσύνη και την κρίση.',
    none: 'Δεν έχει δημοσιευτεί τίποτα ακόμη.',
  },
  de: {
    title: 'Gedanken',
    description: 'Kurze Essays über Architektur, KI und Urteilsvermögen.',
    lede: 'Kurze Essays über Architektur, KI und Urteilsvermögen.',
    none: 'Noch nichts veröffentlicht.',
  },
}[lang];
---

<Base title={copy.title} description={copy.description}>
  <h1>{copy.title}</h1>
  <p class="lede">{copy.lede} <a href="/rss.xml">RSS</a></p>

  {
    posts.length === 0 ? (
      <p class="muted">{copy.none}</p>
    ) : (
      <ol class="plain posts">
        {posts.map(({ entry, lang: postLang, ...p }) => (
          <li>
            <h3 lang={postLang}><a href={postPath({ entry, lang: postLang, ...p })}>{entry.data.title}</a></h3>
            <p class="muted">
              <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date, lang)}</time> ·{' '}
              <span lang={postLang}>{entry.data.description}</span>
              {postLang !== lang && <span> {t(lang).englishOnly}</span>}
            </p>
          </li>
        ))}
      </ol>
    )
  }
</Base>

<style>
  .posts li {
    padding: 1rem 0;
    border-top: 1px solid var(--rule);
  }

  .posts p {
    margin: 0.25rem 0 0;
  }
</style>
