---
import Base from '../layouts/Base.astro';
import { getThoughts } from '../lib/thoughts';
import { formatDate, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const posts = await getThoughts();

const copy = {
  en: {
    title: 'Thoughts',
    description: 'Short essays on architecture, AI, and judgment.',
    lede: 'Short essays on architecture, AI, and judgment.',
    none: 'Nothing published yet.',
  },
  el: {
    title: 'Σκέψεις',
    description: 'Σύντομα κείμενα για την αρχιτεκτονική, την τεχνητή νοημοσύνη και την κρίση.',
    lede: 'Σύντομα κείμενα για την αρχιτεκτονική, την τεχνητή νοημοσύνη και την κρίση. Τα κείμενα είναι στα αγγλικά.',
    none: 'Δεν έχει δημοσιευτεί τίποτα ακόμη.',
  },
  de: {
    title: 'Gedanken',
    description: 'Kurze Essays über Architektur, KI und Urteilsvermögen.',
    lede: 'Kurze Essays über Architektur, KI und Urteilsvermögen. Die Beiträge sind auf Englisch.',
    none: 'Noch nichts veröffentlicht.',
  },
}[lang];
---

<Base title={copy.title} description={copy.description}>
  <h1>{copy.title}</h1>
  <p class="lede">{copy.lede} <a href="/rss.xml">RSS</a></p>

  {
    posts.length === 0 ? (
      <p class="muted">{copy.none}</p>
    ) : (
      <ol class="plain posts">
        {posts.map((p) => (
          <li>
            <h3 lang="en"><a href={`/thoughts/${p.id}/`}>{p.data.title}</a></h3>
            <p class="muted">
              <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date, lang)}</time> ·{' '}
              <span lang="en">{p.data.description}</span>
            </p>
          </li>
        ))}
      </ol>
    )
  }
</Base>

<style>
  .posts li {
    padding: 1rem 0;
    border-top: 1px solid var(--rule);
  }

  .posts p {
    margin: 0.25rem 0 0;
  }
</style>
