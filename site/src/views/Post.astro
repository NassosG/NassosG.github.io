---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { formatDate, localize, type Lang } from '../i18n';
import type { Thought } from '../lib/thoughts';

interface Props {
  post: Thought;
  available: Lang[];
}

const { post, available } = Astro.props;
const { entry, lang } = post;
const { Content } = await render(entry);
const back = { en: '← All thoughts', el: '← Όλες οι σκέψεις', de: '← Alle Gedanken' }[lang];
---

<Base title={entry.data.title} description={entry.data.description} available={available}>
  <article>
    <h1>{entry.data.title}</h1>
    <p class="muted"><time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date, lang)}</time></p>
    <div class="prose">
      <Content />
    </div>
  </article>
  <p><a href={localize('/thoughts/', lang)}>{back}</a></p>
</Base>

<style>
  .prose {
    margin-top: 2rem;
  }

  .prose :global(blockquote) {
    margin: 1.5rem 0;
    padding-left: 1rem;
    border-left: 2px solid var(--accent);
    color: var(--muted);
  }
</style>
