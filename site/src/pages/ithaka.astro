---
import Base from '../layouts/Base.astro';
import { stanzas, archiveUrl, valassopouloUrl } from '../data/ithaka';
---

<Base title="Ithaka" description="C. P. Cavafy’s Ithaka in the original Greek, with links to English translations.">
  <h1>Ithaka</h1>
  <p class="lede">My favorite poem. I believe it is all about the journey.</p>

  <div class="poem" lang="el">
    <p class="title">Ιθάκη</p>
    {
      stanzas.map((stanza) => (
        <p class="stanza">
          {stanza.map((line, i) => (
            <>
              {i > 0 && <br />}
              {line.el}
            </>
          ))}
        </p>
      ))
    }
    <p class="signature">Κωνσταντίνος Π. Καβάφης</p>
  </div>

  <h2>In English</h2>
  <ul class="plain links">
    <li>
      <a href={archiveUrl}>Read “Ithaka” in English</a> in the Cavafy Archive, in the translation by Edmund
      Keeley and Philip Sherrard.
    </li>
    <li>
      <a href={valassopouloUrl}>See the first English translation</a>, handwritten by George Valassopoulo, in the
      Cavafy Archive.
    </li>
  </ul>

  <h2>Sources</h2>
  <ul class="plain sources">
    <li>
      <strong>Greek original:</strong> C. P. Cavafy, «Ιθάκη» (1911). In the public domain. The Greek text and
      manuscripts are held by the <a href={archiveUrl}>Cavafy Archive, Onassis Foundation</a>.
    </li>
    <li>
      <strong>English translation:</strong> C. P. Cavafy, “Ithaka,” in <cite>C. P. Cavafy: Collected Poems</cite>,
      rev. ed., trans. Edmund Keeley and Philip Sherrard, ed. George Savidis (Princeton University Press, 1992).
    </li>
    <li>
      <strong>First English translation:</strong> C. P. Cavafy, “Ithaca,” trans. George Valassopoulo,{' '}
      <cite>The Criterion</cite> 2, no. 8 (July 1924): 431–432.
    </li>
    <li>
      <strong>On the home page:</strong> “Ask that your way be long” is from another English translation of
      the poem.
    </li>
  </ul>
</Base>

<style>
  .poem {
    margin: 2.5rem 0 1rem;
    font-family: var(--serif);
    font-size: 1.125rem;
    line-height: 1.6;
  }

  .title {
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .stanza {
    margin: 0 0 1.4em;
  }

  .signature {
    margin-top: 2rem;
    font-family: var(--sans);
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .links li,
  .sources li {
    padding: 0.4rem 0;
  }

  .sources li {
    font-size: 0.9375rem;
  }
</style>
