---
import Base from '../../layouts/Base.astro';
import PubLinks from '../../components/PubLinks.astro';
import { site } from '../../data/site';
import { getPublications } from '../../lib/publications';

const pubs = await getPublications();

const areas = [
  {
    title: 'Evidence-grounded attack attribution',
    text: 'Mapping system telemetry to MITRE ATT&CK techniques, and separating what evidence was available, what was retrieved, and what the system committed to.',
  },
  {
    title: 'Temporal knowledge graphs for threat intelligence',
    text: 'Linking events, entities, and techniques over time so that attributions can be traced back to their evidence.',
  },
  {
    title: 'Commitment across the delegation chain',
    text: 'How one system’s decision to commit or withhold shapes the judgment of the next agent downstream.',
  },
  {
    title: 'Bounded autonomy for AI agents',
    text: 'As autonomous as possible, as bounded as necessary.',
  },
  {
    title: 'LLM-enabled phishing',
    text: 'How large language models change phishing inside large organizations, and how to defend against it.',
  },
];
---

<Base title="Research" description="Research on evidence-grounded attack attribution, AI agents, and LLM-enabled phishing.">
  <h1>Research</h1>
  <p class="lede">Ph.D. candidate in Cybersecurity and AI at The University of Texas at San Antonio.</p>

  <h2>Areas of focus</h2>
  <dl class="areas">
    {
      areas.map((a) => (
        <>
          <dt>{a.title}</dt>
          <dd>{a.text}</dd>
        </>
      ))
    }
  </dl>

  <h2>Publications</h2>
  <ol class="plain pubs">
    {
      pubs.map((p) => (
        <li>
          <h3>
            <a href={`/research/${p.id}/`}>{p.data.title}</a>
          </h3>
          <p class="muted">{p.data.authors}</p>
          <PubLinks data={p.data} />
        </li>
      ))
    }
  </ol>

  <p class="profiles">
    <a href={site.links.scholar}>Google Scholar</a> · <a href={site.links.orcid}>ORCID</a>
  </p>
</Base>

<style>
  .areas dt {
    font-family: var(--serif);
    font-size: 1.125rem;
    margin-top: 1rem;
  }

  .areas dd {
    margin: 0.25rem 0 0;
    color: var(--muted);
  }

  .pubs li {
    padding: 1.25rem 0;
    border-top: 1px solid var(--rule);
  }

  .pubs h3 a {
    color: var(--fg);
    text-decoration: none;
  }

  .pubs h3 a:hover {
    text-decoration: underline;
  }

  .pubs p {
    margin: 0.25rem 0 0;
  }

  .profiles {
    margin-top: 1.5rem;
  }
</style>
