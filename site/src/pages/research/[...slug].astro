---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PubLinks from '../../components/PubLinks.astro';
import { getPublications } from '../../lib/publications';

export async function getStaticPaths() {
  const pubs = await getPublications();
  return pubs.map((pub) => ({ params: { slug: pub.id }, props: { pub } }));
}

const { pub } = Astro.props;
const { Content } = await render(pub);
const { data } = pub;
// Highwire Press tags, read by Google Scholar.
const authors = data.authors
  .replace(/,?\s*&\s*/g, ', ')
  .split(/(?<=\.),\s+/)
  .map((a) => a.trim().replace(/,$/, ''))
  .filter(Boolean);
const [firstPage, lastPage] = (data.pages ?? '').split(/[–-]/);
---

<Base title={data.title} description={`${data.venue}, ${data.year}. ${data.authors}`}>
  <Fragment slot="head">
    <meta name="citation_title" content={data.title} />
    {authors.map((a) => <meta name="citation_author" content={a} />)}
    <meta name="citation_publication_date" content={String(data.year)} />
    <meta name="citation_journal_title" content={data.venue} />
    {data.volume && <meta name="citation_volume" content={data.volume} />}
    {firstPage && <meta name="citation_firstpage" content={firstPage} />}
    {lastPage && <meta name="citation_lastpage" content={lastPage} />}
    {data.doi && <meta name="citation_doi" content={data.doi} />}
    {data.pdf && <meta name="citation_pdf_url" content={new URL(data.pdf, Astro.site)} />}
  </Fragment>
  <article>
    <h1 class="title">{pub.data.title}</h1>
    <p class="muted">{pub.data.authors}</p>
    <PubLinks data={pub.data} />
    <div class="prose">
      <Content />
    </div>
  </article>
  <p><a href="/research/">← All research</a></p>
</Base>

<style>
  .title {
    font-size: clamp(1.5rem, 1.3rem + 1vw, 2rem);
  }

  .prose {
    margin-top: 2rem;
  }
</style>
