---
import Post from '../../views/Post.astro';
import { getThoughtsFor, languagesOf, type Thought } from '../../lib/thoughts';

export async function getStaticPaths() {
  const posts = await getThoughtsFor('en');
  return Promise.all(
    posts.map(async (post) => ({ params: { slug: post.slug }, props: { post, available: await languagesOf(post.slug) } })),
  );
}

const { post, available } = Astro.props as { post: Thought; available: Awaited<ReturnType<typeof languagesOf>> };
---

<Post post={post} available={available} />
