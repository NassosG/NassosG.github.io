---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base title="Contact" description={`How to reach ${site.name}.`}>
  <h1>Contact</h1>
  <p class="lede">For speaking, advisory, research collaboration, or a good question.</p>

  <dl>
    {
      site.email && (
        <>
          <dt>Email</dt>
          <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
        </>
      )
    }
    <dt>LinkedIn</dt>
    <dd><a href={site.links.linkedin} rel="me">linkedin.com/in/nassosg</a></dd>
    <dt>Based in</dt>
    <dd>{site.location}</dd>
  </dl>
</Base>

<style>
  dl {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.75rem 2rem;
    margin: 0;
  }

  dt {
    color: var(--muted);
  }

  dd {
    margin: 0;
  }
</style>
