---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Questions from '../components/Questions.astro';
import { site } from '../data/site';

const pubs = (await getCollection('publications')).sort((a, b) => b.data.year - a.data.year);
---

<Base title="Research" description="Research on enterprise architecture, AI agents and cybersecurity.">
  <h1>Research</h1>
  <p class="lede">
    Ph.D. candidate in Cybersecurity and AI at The University of Texas at San Antonio.
  </p>
  <p>
    My dissertation focuses on actionable threat intelligence: detection and defense frameworks for
    LLM-driven phishing in large organizations. More broadly, I study how to give AI systems enough
    autonomy to be useful while keeping their actions bounded, verifiable, and defensible.
  </p>

  <h2>Key questions</h2>
  <Questions />

  <h2>Publications</h2>
  <ol class="plain pubs">
    {
      pubs.map(({ data }) => (
        <li>
          <h3>{data.title}</h3>
          <p class="muted">{data.authors}</p>
          <p>
            <em>{data.venue}</em>, {data.year}
            {data.status !== 'published' && <span class="muted"> · {data.status}</span>}
            {data.doi && (
              <>
                {' · '}
                <a href={`https://doi.org/${data.doi}`}>DOI</a>
              </>
            )}
            {data.pdf && (
              <>
                {' · '}
                <a href={data.pdf}>PDF</a>
              </>
            )}
          </p>
        </li>
      ))
    }
  </ol>

  {
    (site.links.scholar || site.links.orcid) && (
      <p class="profiles">
        {site.links.scholar && <a href={site.links.scholar}>Google Scholar</a>}
        {site.links.scholar && site.links.orcid && ' · '}
        {site.links.orcid && <a href={site.links.orcid}>ORCID</a>}
      </p>
    )
  }
</Base>

<style>
  .pubs li {
    padding: 1.25rem 0;
    border-top: 1px solid var(--rule);
  }

  .pubs p {
    margin: 0.25rem 0 0;
  }

  .profiles {
    margin-top: 1.5rem;
  }
</style>
