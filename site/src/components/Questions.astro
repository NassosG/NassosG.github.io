---
import { questions } from '../data/site';
---

<ol class="questions">
  {questions.map((q) => <li>{q}</li>)}
</ol>

<style>
  .questions {
    list-style: none;
    counter-reset: q;
    padding: 0;
    margin: 0;
  }

  .questions li {
    counter-increment: q;
    position: relative;
    padding: 1rem 0 1rem 2.5rem;
    border-top: 1px solid var(--rule);
    font-family: var(--serif);
    font-size: 1.125rem;
    line-height: 1.5;
  }

  .questions li::before {
    content: counter(q, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 1.2rem;
    font-family: var(--sans);
    font-size: 0.8125rem;
    color: var(--accent);
  }
</style>
