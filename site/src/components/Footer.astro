---
import { site, profile } from '../data/site';
import { getLang, t } from '../i18n';

const lang = getLang(Astro.url);
const labels: Record<string, string> = {
  linkedin: 'LinkedIn',
  scholar: 'Google Scholar',
  orcid: 'ORCID',
  github: 'GitHub',
};
const links = Object.entries(site.links).filter(([, href]) => href);
---

<footer class="wrap">
  <hr />
  <ul class="plain">
    {site.email && <li><a href={`mailto:${site.email}`}>{t(lang).email}</a></li>}
    {links.map(([key, href]) => <li><a href={href} rel="me">{labels[key]}</a></li>)}
  </ul>
  <p class="muted">
    © {new Date().getFullYear()} {profile[lang].name} · <abbr title={t(lang).limurTitle}>limur</abbr>
  </p>
</footer>

<style>
  footer {
    padding-top: 2rem;
    padding-bottom: 3rem;
    font-size: 0.9375rem;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-bottom: 1rem;
  }

  abbr {
    text-decoration: none;
  }
</style>
