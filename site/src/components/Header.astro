---
import { profile, navKeys } from '../data/site';
import { getThoughts } from '../lib/thoughts';
import { getLang, basePath, localize, switchTo, langs, langMeta, t, type Lang } from '../i18n';

const { available } = Astro.props as { available?: Lang[] };
const lang = getLang(Astro.url);
const base = basePath(Astro.url);
// Less is more: Thoughts stays out of the menu until something is published.
const hasThoughts = (await getThoughts()).length > 0;
const items = navKeys
  .filter((k) => k !== 'thoughts' || hasThoughts)
  .map((k) => ({ key: k, path: `/${k}/`, label: t(lang).nav[k] }));
---

<header class="wrap">
  <a class="name" href={localize('/', lang)}>{profile[lang].name}</a>
  <div class="bar">
    <nav aria-label="Main">
      {
        items.map((item) => (
          <a href={localize(item.path, lang)} aria-current={base.startsWith(item.path) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <nav class="langs" aria-label={t(lang).langSwitch}>
      {
        langs.map((l) =>
          l === lang ? (
            <span aria-current="true" title={langMeta[l].name}>{langMeta[l].label}</span>
          ) : (
            <a href={switchTo(Astro.url, l, available)} hreflang={l} lang={l} title={langMeta[l].name}>
              {langMeta[l].label}
            </a>
          ),
        )
      }
    </nav>
  </div>
</header>

<style>
  header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-top: 2rem;
    padding-bottom: 3.5rem;
  }

  .name {
    font-family: var(--serif);
    font-size: 1.125rem;
    color: var(--fg);
    text-decoration: none;
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1.25rem;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    font-size: 0.9375rem;
  }

  nav a {
    color: var(--muted);
    text-decoration: none;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--fg);
  }

  .langs {
    gap: 0.6rem;
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    padding-left: 1.25rem;
    border-left: 1px solid var(--rule);
  }

  .langs span {
    color: var(--fg);
  }

  @media (max-width: 40rem) {
    .langs {
      padding-left: 0;
      border-left: 0;
    }
  }
</style>
